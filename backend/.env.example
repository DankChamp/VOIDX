# Backend environment for VOIDX.
# Copy to `backend/.env` and fill in. `backend/.env` is gitignored — never commit real secrets.
# Run:  uvicorn backend.main:app --host 0.0.0.0 --port 8000

# JWT signing key. REQUIRED for production. If unset, runs on an insecure dev fallback.
SECRET_KEY=change-me-to-a-long-random-string

# Async DB URL. SQLite example below; for production use Postgres e.g.:
#   postgresql+asyncpg://user:pass@host:5432/voidx
DATABASE_URL=sqlite+aiosqlite:///./voidx.db

# Groq API key for the PII sanitizer. Optional: without it, messages are stored raw (no anonymizing).
GROQ_API_KEY=

# Optional overrides (defaults shown are fine to leave unset)
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
